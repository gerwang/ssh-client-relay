#!/usr/bin/env bash
set -o pipefail

config_file="${SSH_CLIENT_RELAY_CONFIG:-$HOME/.config/ssh-client-relay/config}"
if [[ -r "$config_file" ]]; then
    # The config is generated by install.sh and is owned by the local user.
    source "$config_file"
fi

: "${SSH:=/usr/bin/ssh}"
: "${RELAY_HOST:?RELAY_HOST is not configured; run install.sh}"
: "${TARGET_ALIAS:?TARGET_ALIAS is not configured; run install.sh}"
: "${TARGET_HOST:?TARGET_HOST is not configured; run install.sh}"
: "${REMOTE_HELPER:=~/.local/bin/ssh-client-relay-helper}"

use_relay=false
forwarded=()
outer_forwarding=()

for arg in "$@"; do
    case "$arg" in
        "$TARGET_ALIAS")
            use_relay=true
            forwarded+=("$TARGET_HOST")
            ;;
        "$TARGET_HOST")
            use_relay=true
            forwarded+=("$arg")
            ;;
        *)
            forwarded+=("$arg")
            ;;
    esac
done

if ! "$use_relay"; then
    exec "$SSH" "$@"
fi

# A relayed -D listener lives on the relay. Bridge it back to the client so
# callers such as VS Code can reach the SOCKS port at their expected localhost.
for ((i = 0; i < ${#forwarded[@]}; i++)); do
    dynamic_spec=
    if [[ "${forwarded[i]}" == -D && $((i + 1)) -lt ${#forwarded[@]} ]]; then
        dynamic_spec="${forwarded[i + 1]}"
        ((i++))
    elif [[ "${forwarded[i]}" == -D?* ]]; then
        dynamic_spec="${forwarded[i]#-D}"
    fi
    if [[ -n "$dynamic_spec" ]]; then
        dynamic_port="${dynamic_spec##*:}"
        [[ "$dynamic_port" =~ ^[0-9]+$ ]] || {
            printf 'ssh-client-relay: unsupported dynamic-forward spec: %s\n' \
                "$dynamic_spec" >&2
            exit 64
        }
        outer_forwarding+=(-L "${dynamic_spec}:127.0.0.1:${dynamic_port}")
    fi
done

send_request() {
    printf 'SSH_CLIENT_RELAY_ARGS_V1\0%d\0' "${#forwarded[@]}"
    if ((${#forwarded[@]})); then
        printf '%s\0' "${forwarded[@]}"
    fi
    perl -MFcntl=F_GETFL,F_SETFL,O_NONBLOCK -e '
        use strict;
        use warnings;
        use Errno qw(EAGAIN EINTR);
        my $flags = fcntl(STDIN, F_GETFL, 0);
        fcntl(STDIN, F_SETFL, $flags & ~O_NONBLOCK)
            or die "cannot make stdin blocking: $!\n";
        while (1) {
            my $read = sysread(STDIN, my $buffer, 65536);
            if (!defined $read) {
                if ($! == EAGAIN || $! == EINTR) {
                    select undef, undef, undef, 0.01;
                    next;
                }
                die "cannot read stdin: $!\n";
            }
            last if $read == 0;
            my $offset = 0;
            while ($offset < $read) {
                my $written = syswrite(STDOUT, $buffer, $read - $offset, $offset);
                if (!defined $written) {
                    if ($! == EAGAIN || $! == EINTR) {
                        select undef, undef, undef, 0.01;
                        next;
                    }
                    die "cannot write relay stream: $!\n";
                }
                $offset += $written;
            }
        }
    '
}

send_request | "$SSH" -x -T "${outer_forwarding[@]}" \
    "$RELAY_HOST" "$REMOTE_HELPER"
