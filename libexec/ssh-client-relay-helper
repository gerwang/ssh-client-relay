#!/usr/bin/env bash
set -euo pipefail

IFS= read -r -d '' magic || exit 64
[[ "$magic" == SSH_CLIENT_RELAY_ARGS_V1 ]] || exit 64

IFS= read -r -d '' count || exit 64
[[ "$count" =~ ^[0-9]+$ ]] || exit 64
((count <= 4096)) || exit 64

args=()
for ((i = 0; i < count; i++)); do
    IFS= read -r -d '' arg || exit 64
    args+=("$arg")
done

exec /usr/bin/ssh "${args[@]}"
